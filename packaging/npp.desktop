[Desktop Entry]
Type=Application
Name=Neko++
GenericName=Text Editor
Comment=A GPU-rendered Notepad++ workalike
Exec=npp %F
Icon=npp
Terminal=false
Categories=Utility;TextEditor;Development;
Keywords=text;editor;notepad;code;
MimeType=text/plain;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-rust;text/x-python;text/x-shellscript;application/json;application/xml;
StartupWMClass=npp
